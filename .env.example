# Enterprise AI Agent v0.2.0
APP_NAME=enterprise-ai-agent
APP_ENV=development
APP_VERSION=0.2.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security (for future phases)
SECRET_KEY=your-secret-key-change-in-production

# LLM Provider Configuration
# Supported: 'fake' (default), 'openai' (placeholder, not implemented)
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-3.5-turbo

# Embedding Provider Configuration
# Supported: 'fake' (default), 'openai' (placeholder, not implemented)
EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# RAG Configuration
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_DIMENSION=1536
RAG_TOP_K=4
RAG_SNIPPET_MAX_LENGTH=300
