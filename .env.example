# Enterprise AI Agent v1.0.0
APP_NAME=enterprise-ai-agent
APP_ENV=development
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth compatibility mode
# Development can set false to keep historical demo flows working without login.
# Production must set true or the app fails fast.
AUTH_REQUIRED=true

# LLM Provider Configuration
# Supported: 'fake' (default), 'openai'
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# Embedding Provider Configuration
# Supported: 'fake' (default), 'openai'
EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Provider Configuration
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# RAG Configuration
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_DIMENSION=1536
RAG_TOP_K=4
RAG_SNIPPET_MAX_LENGTH=300

# RAG Advanced Configuration
RAG_CHUNK_STRATEGY=fixed
RAG_RETRIEVAL_MODE=vector
RAG_RERANKER_PROVIDER=none

# Agent Planning Configuration
# Empty means deterministic in development/test and llm in production.
AGENT_PLANNER_PROVIDER=

# MCP Configuration
# Enable demo MCP tools (mcp_echo, mcp_get_business_metric, mcp_create_ticket).
# Production must set false or the app fails fast.
MCP_DEMO_ENABLED=false
# Optional JSON array of extra MCP server configs.
# Phase 3 supports in_process and stdio locally; http is a placeholder extension point.
# Example:
# MCP_SERVER_CONFIGS=[{"name":"stdio_demo","transport":"stdio","enabled":true,"namespace":"mcp","command":["python","-m","app.mcp.demo_stdio_server"]}]
MCP_SERVER_CONFIGS=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
