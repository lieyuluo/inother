# Enterprise AI Agent v1.0.0
APP_NAME=enterprise-ai-agent
APP_ENV=development
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth compatibility mode
# false keeps historical demo flows working without login.
# Set true in secured deployments so Chat/Document/Tool APIs require JWT auth.
AUTH_REQUIRED=false

# LLM Provider Configuration
# Supported: 'fake' (default), 'openai'
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# Embedding Provider Configuration
# Supported: 'fake' (default), 'openai'
EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Provider Configuration
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# RAG Configuration
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_DIMENSION=1536
RAG_TOP_K=4
RAG_SNIPPET_MAX_LENGTH=300

# MCP Configuration
# Enable demo MCP tools (mcp_echo, mcp_get_business_metric, mcp_create_ticket)
MCP_DEMO_ENABLED=true
# Optional JSON array of extra MCP server configs.
# Phase 3 supports in_process and stdio locally; http is a placeholder extension point.
# Example:
# MCP_SERVER_CONFIGS=[{"name":"stdio_demo","transport":"stdio","enabled":true,"namespace":"mcp","command":["python","-m","app.mcp.demo_stdio_server"]}]
MCP_SERVER_CONFIGS=
